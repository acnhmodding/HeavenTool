<fa:FAAppWindow  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:fa="clr-namespace:FluentAvalonia.UI.Windowing;assembly=FluentAvalonia"
  xmlns:vm="clr-namespace:HeavenTool.Avalonia.ViewModels;assembly=HeavenTool.Avalonia"
  xmlns:app="clr-namespace:HeavenTool.Avalonia;assembly=HeavenTool.Avalonia"
  mc:Ignorable="d"
  Width="800" Height="600"
  x:Class="HeavenTool.Avalonia.Views.FileEditors.BCSVWindow"
  Title="Heaven Tool"
  Background="{StaticResource WindowBackground}"
  x:DataType="vm:BCSVViewModel">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenFileCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveFileCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewRowCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+N" Command="{Binding NewEntryCommand}" />
    <KeyBinding Gesture="Ctrl+D" Command="{Binding DuplicateRowsCommand}" />
    <KeyBinding Gesture="Ctrl+F" Command="{Binding OpenSearchCommand}" />
    <KeyBinding Gesture="Ctrl+H" Command="{Binding OpenReplaceCommand}" />
    <KeyBinding Gesture="F3" Command="{Binding FindNextCommand}" />
    <KeyBinding Gesture="Shift+F3" Command="{Binding FindPreviousCommand}" />
  </Window.KeyBindings>

  <Grid RowDefinitions="Auto, *">
    <DockPanel Grid.Row="0" Height="32" Background="{StaticResource TitleBarBackground}"
      WindowDecorationProperties.ElementRole="TitleBar">
      <Image Source="/Assets/Icons/leaf.ico" Margin="10 0" Height="16"/>
      <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Margin="0 0 0 0" Text="{Binding Title, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"/>
      <TextBlock Text="{x:Static app:App.DisplayVersion}" Margin="5 0 0 0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource DimText}"/>
    </DockPanel>
    <DockPanel Grid.Row="1">
      <Menu DockPanel.Dock="Top" Padding="0" Background="{StaticResource MenuBackground}" Height="30" Foreground="White" FontSize="11">
        <MenuItem Header="_File">
          <MenuItem Header="_Open..." Command="{Binding OpenFileCommand}" InputGesture="Ctrl+O">
            <MenuItem.Icon>
              <PathIcon Data="{StaticResource IconFile}" Width="14" Height="14" />
            </MenuItem.Icon>
          </MenuItem>

          <MenuItem Header="_Save" Command="{Binding SaveFileCommand}" InputGesture="Ctrl+S">
            <MenuItem.Icon>
              <PathIcon Data="{StaticResource IconSave}" Width="14" Height="14" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="Save _as..." Command="{Binding SaveAsCommand}" InputGesture="Ctrl+Shift+S">
            <MenuItem.Icon>
              <PathIcon Data="{StaticResource IconFileExport}" Width="14" Height="14" />
            </MenuItem.Icon>
          </MenuItem>

          <Separator/>

          <MenuItem Header="_Import Rows..." Command="{Binding ImportRowsCommand}">
            <MenuItem.Icon>
              <PathIcon Data="{StaticResource IconFileImport}" Width="14" Height="14" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="_Export" IsEnabled="{Binding IsFileLoaded}">
            <MenuItem.Icon>
              <PathIcon Data="{StaticResource IconExport}" Width="14" Height="14" />
            </MenuItem.Icon>
            <MenuItem Header="As _CSV..." Command="{Binding ExportCsvCommand}">
              <MenuItem.Icon>
                <PathIcon Data="{StaticResource IconFileCsv}" Width="14" Height="14" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="_Selected Rows..." Command="{Binding ExportSelectionCommand}">
              <MenuItem.Icon>
                <PathIcon Data="{StaticResource IconTableList}" Width="14" Height="14" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Current Column _Values..." Command="{Binding ExportColumnValuesCommand}">
              <MenuItem.Icon>
                <PathIcon Data="{StaticResource IconList}" Width="14" Height="14" />
              </MenuItem.Icon>
            </MenuItem>
          </MenuItem>

          <Separator/>

          <MenuItem Header="Column _Visibility" IsEnabled="{Binding IsFileLoaded}">
            <MenuItem.Icon>
              <PathIcon Data="{StaticResource IconEye}" Width="14" Height="14" />
            </MenuItem.Icon>
            <MenuItem.Items>
              <CheckBox Content="Toggle All" IsThreeState="True" IsChecked="{Binding ToggleAll, Mode=TwoWay}" />
              <Separator/>
              <ItemsControl ItemsSource="{Binding Columns}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox Content="{Binding Header}" IsChecked="{Binding IsVisible, Mode=TwoWay}" IsVisible="{Binding IsListed}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </MenuItem.Items>
          </MenuItem>

          <Separator/>

          <MenuItem Header="Unload" Command="{Binding CloseFileCommand}">
            <MenuItem.Icon>
              <PathIcon Data="{StaticResource IconClose}" Width="14" Height="14" />
            </MenuItem.Icon>

          </MenuItem>
        </MenuItem>

        <MenuItem Header="_Edit" IsEnabled="{Binding IsFileLoaded}">
          <MenuItem Header="_Undo" Command="{Binding UndoCommand}" InputGesture="Ctrl+Z">
            <MenuItem.Icon>
              <PathIcon Data="{StaticResource IconUndo}" Width="14" Height="14" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="_Redo" Command="{Binding RedoCommand}" InputGesture="Ctrl+Y">
            <MenuItem.Icon>
              <PathIcon Data="{StaticResource IconRedo}" Width="14" Height="14" />
            </MenuItem.Icon>
          </MenuItem>

          <Separator/>

          <MenuItem Header="_Copy" Command="{Binding CopyCommand}" InputGesture="Ctrl+C">
            <MenuItem.Icon>
              <PathIcon Data="{StaticResource IconClipboard}" Width="14" Height="14" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="Copy with _Headers" Command="{Binding CopyWithHeadersCommand}">
            <MenuItem.Icon>
              <PathIcon Data="{StaticResource IconTable}" Width="14" Height="14" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="Copy Ce_ll" Command="{Binding CopyCellCommand}" InputGesture="Ctrl+Shift+C">
            <MenuItem.Icon>
              <PathIcon Data="{StaticResource IconTableCells}" Width="14" Height="14" />
            </MenuItem.Icon>
          </MenuItem>

          <Separator/>

          <MenuItem Header="_New Row" Command="{Binding NewRowCommand}" InputGesture="Ctrl+N">
            <MenuItem.Icon>
              <PathIcon Data="{StaticResource IconPlus}" Width="14" Height="14" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="New _Entry..." Command="{Binding NewEntryCommand}" InputGesture="Ctrl+Shift+N">
            <MenuItem.Icon>
              <PathIcon Data="{StaticResource IconPenToSquare}" Width="14" Height="14" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="_Duplicate Rows" Command="{Binding DuplicateRowsCommand}" InputGesture="Ctrl+D">
            <MenuItem.Icon>
              <PathIcon Data="{StaticResource IconCopy}" Width="14" Height="14" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="De_lete Rows" Command="{Binding DeleteRowsCommand}" InputGesture="Delete">
            <MenuItem.Icon>
              <PathIcon Data="{StaticResource IconTrash}" Width="14" Height="14" />
            </MenuItem.Icon>
          </MenuItem>

          <Separator/>

          <MenuItem Header="_Find..." Command="{Binding OpenSearchCommand}" InputGesture="Ctrl+F">
            <MenuItem.Icon>
              <PathIcon Data="{StaticResource IconSearch}" Width="14" Height="14" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="Find Ne_xt" Command="{Binding FindNextCommand}" InputGesture="F3">
            <MenuItem.Icon>
              <PathIcon Data="{StaticResource IconChevronDown}" Width="14" Height="14" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="Find Pre_vious" Command="{Binding FindPreviousCommand}" InputGesture="Shift+F3">
            <MenuItem.Icon>
              <PathIcon Data="{StaticResource IconChevronUp}" Width="14" Height="14" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="R_eplace..." Command="{Binding OpenReplaceCommand}" InputGesture="Ctrl+H">
            <MenuItem.Icon>
              <PathIcon Data="{StaticResource IconReplace}" Width="14" Height="14" />
            </MenuItem.Icon>
          </MenuItem>
        </MenuItem>

      </Menu>

      <!-- One shared height keeps the boxes and buttons aligned; the boxes take the spare width. -->
      <Border DockPanel.Dock="Top" IsVisible="{Binding IsSearchOpen}" Background="{StaticResource PanelBackground}"
        BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="6,4"
        Container.Name="SearchBar" Container.Sizing="Width">
        <Border.KeyBindings>
          <KeyBinding Gesture="Escape" Command="{Binding CloseSearchCommand}" />
        </Border.KeyBindings>
        <Border.Styles>
          <Style Selector="TextBox, Button, ToggleButton">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
          </Style>
          <Style Selector="TextBox">
            <Setter Property="Padding" Value="8,0,4,0" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
          </Style>
          <Style Selector="Button, ToggleButton">
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
          </Style>
          <Style Selector="Button.icon, ToggleButton.icon">
            <Setter Property="Width" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
          </Style>
          <!-- Option toggles sit inside the find box, like a code editor's. -->
          <Style Selector="ToggleButton.option">
            <Setter Property="Height" Value="22" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
          </Style>
          <Style Selector="ToggleButton#ReplaceToggle">
            <Setter Property="Height" Value="NaN" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
          </Style>
          <Style Selector="ToggleButton#ReplaceToggle:unchecked PathIcon">
            <Setter Property="RenderTransform" Value="rotate(-90deg)" />
          </Style>
          <ContainerQuery Name="SearchBar" Query="max-width:460">
            <Style Selector="TextBlock#SearchSummary">
              <Setter Property="IsVisible" Value="False" />
            </Style>
          </ContainerQuery>
        </Border.Styles>
        <!-- The boxes stop growing at a readable width; the buttons stay next to them. -->
        <Grid RowDefinitions="Auto,Auto" ColumnSpacing="4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MaxWidth="480" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ToggleButton x:Name="ReplaceToggle" Grid.RowSpan="2" Classes="icon"
            IsChecked="{Binding IsReplaceOpen}" ToolTip.Tip="Toggle replace (Ctrl+H)">
            <!-- It's an expander, so the chevron shows the state rather than an accent fill. -->
            <ToggleButton.Resources>
              <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="ButtonBackground" />
              <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="ButtonBackgroundPointerOver" />
              <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="ButtonBackgroundPressed" />
              <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="ButtonForeground" />
              <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="ButtonForegroundPointerOver" />
              <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="ButtonForegroundPressed" />
              <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="ButtonBorderBrush" />
              <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="ButtonBorderBrushPointerOver" />
              <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="ButtonBorderBrushPressed" />
            </ToggleButton.Resources>
            <PathIcon Data="{StaticResource IconChevronDown}" Width="10" Height="10" />
          </ToggleButton>

          <TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="Find in visible columns"
            Text="{Binding SearchText}">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding FindNextCommand}" />
              <KeyBinding Gesture="Shift+Enter" Command="{Binding FindPreviousCommand}" />
            </TextBox.KeyBindings>
            <TextBox.InnerRightContent>
              <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,0,3,0">
                <ToggleButton Classes="option" Content="Aa" IsChecked="{Binding MatchCase}"
                  ToolTip.Tip="Match case" />
                <ToggleButton Classes="option" IsChecked="{Binding MatchWholeCell}"
                  ToolTip.Tip="Match whole cell">
                  <Border BorderThickness="1" CornerRadius="2" Padding="2,0"
                    BorderBrush="{Binding $parent[ToggleButton].Foreground}">
                    <TextBlock Text="ab" FontSize="10" />
                  </Border>
                </ToggleButton>
                <ToggleButton Classes="option" IsChecked="{Binding FilterMatches}"
                  ToolTip.Tip="Show only rows with a match">
                  <PathIcon Data="{StaticResource IconFilter}" Width="11" Height="11" />
                </ToggleButton>
              </StackPanel>
            </TextBox.InnerRightContent>
          </TextBox>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
            <!-- A fixed width stops the buttons shifting as the count changes. -->
            <TextBlock x:Name="SearchSummary" Text="{Binding SearchSummary}" Width="96"
              VerticalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis"
              FontSize="12" Foreground="{StaticResource SecondaryText}" />
            <Button Classes="icon" Command="{Binding FindPreviousCommand}" ToolTip.Tip="Previous match (Shift+F3)">
              <PathIcon Data="{StaticResource IconChevronUp}" Width="12" Height="12" />
            </Button>
            <Button Classes="icon" Command="{Binding FindNextCommand}" ToolTip.Tip="Next match (F3)">
              <PathIcon Data="{StaticResource IconChevronDown}" Width="12" Height="12" />
            </Button>
            <Button Classes="icon" Command="{Binding CloseSearchCommand}" ToolTip.Tip="Close (Esc)">
              <PathIcon Data="{StaticResource IconClose}" Width="10" Height="10" />
            </Button>
          </StackPanel>

          <TextBox x:Name="ReplaceBox" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" PlaceholderText="Replace with"
            Text="{Binding ReplaceText}" IsVisible="{Binding IsReplaceOpen}">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding ReplaceNextCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,4,0,0" Orientation="Horizontal" Spacing="4"
            IsVisible="{Binding IsReplaceOpen}">
            <Button Content="Replace" Command="{Binding ReplaceNextCommand}"
              ToolTip.Tip="Replace this match and go to the next (Enter)" />
            <Button Content="Replace All" Command="{Binding ReplaceAllCommand}"
              ToolTip.Tip="Replace every match in the visible columns as one undo step" />
          </StackPanel>
        </Grid>
      </Border>

      <StackPanel DockPanel.Dock="Bottom" Margin="8,4" Spacing="3">
        <ProgressBar Height="3" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
        <TextBlock Text="{Binding StatusText}" FontSize="11" />
        <TextBlock Text="{Binding WarningMessage}" IsVisible="{Binding HasWarning}"
          Foreground="{StaticResource WarningText}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
          Foreground="{StaticResource ErrorText}" TextWrapping="Wrap" />
      </StackPanel>
      <DataGrid x:Name="MainDataGrid"
        Background="{StaticResource GridBackground}"
        Foreground="White"
        GridLinesVisibility="Vertical"
        HeadersVisibility="All"
        RowHeaderWidth="52"
        SelectionMode="Extended"
        IsVisible="{Binding IsFileLoaded}"
        CanUserSortColumns="True"
        CanUserResizeColumns="True"
        AutoGenerateColumns="False"
        ClipboardCopyMode="None"
        RowHeight="32"
        ColumnHeaderHeight="30"
        IsReadOnly="{Binding IsBusy}"
        IsHitTestVisible="{Binding !IsBusy}">

        <!-- Scoped to the grid so Delete and Ctrl+C in the search box only edit text. -->
        <DataGrid.KeyBindings>
          <KeyBinding Gesture="Delete" Command="{Binding DeleteRowsCommand}" />
          <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyCommand}" />
          <KeyBinding Gesture="Ctrl+Shift+C" Command="{Binding CopyCellCommand}" />
        </DataGrid.KeyBindings>

        <DataGrid.Resources>
          <!-- Wide tables instantiate thousands of cells. Keep their template small;
            focus and validation share the border instead of extra visual layers. -->
          <ControlTheme x:Key="{x:Type DataGridCell}" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
              <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
                  <Grid ColumnDefinitions="*,Auto">
                    <ContentPresenter Content="{TemplateBinding Content}"
                      ContentTemplate="{TemplateBinding ContentTemplate}"
                      Foreground="{TemplateBinding Foreground}"
                      Margin="{TemplateBinding Padding}"
                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    <Rectangle Name="PART_RightGridLine" Grid.Column="1" Width="1" />
                  </Grid>
                </Border>
              </ControlTemplate>
            </Setter>
            <Style Selector="^:current">
              <Setter Property="BorderBrush" Value="{StaticResource ACNHGreen}" />
            </Style>
            <Style Selector="^:invalid">
              <Setter Property="BorderBrush" Value="{StaticResource ErrorText}" />
            </Style>
          </ControlTheme>
        </DataGrid.Resources>

        <DataGrid.Styles>

          <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource GridHeaderBackground}" />
            <Setter Property="Foreground" Value="White" />
          </Style>

          <!-- Row numbers follow the view, as in the WinForms editor. -->
          <Style Selector="DataGridRowHeader">
            <Setter Property="Foreground" Value="{StaticResource GridRowNumberText}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="Padding" Value="0,0,6,0" />
          </Style>

          <Style Selector="DataGridRow:nth-child(odd)">
            <Setter Property="Background" Value="{StaticResource GridAlternateRowBackground}"/>
          </Style>

          <Style Selector="DataGridRow">
            <Setter Property="Background" Value="{StaticResource GridRowBackground}"/>
            <Setter Property="Foreground" Value="White"/>
          </Style>

        </DataGrid.Styles>
      </DataGrid>
    </DockPanel>
  </Grid>
</fa:FAAppWindow>
