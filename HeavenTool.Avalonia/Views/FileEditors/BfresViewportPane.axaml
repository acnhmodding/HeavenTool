<UserControl xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:icons="https://github.com/MahApps/IconPacks.Avalonia"
  xmlns:vm="using:HeavenTool.Avalonia.ViewModels"
  xmlns:controls="using:HeavenTool.Avalonia.Controls"
  xmlns:views="using:HeavenTool.Avalonia.Views.FileEditors"
  x:Class="HeavenTool.Avalonia.Views.FileEditors.BfresViewportPane"
  x:DataType="vm:BfresViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
      BorderThickness="0,0,0,1" Padding="4,3" Container.Name="Toolbar" Container.Sizing="Width">
      <Border.Styles>
        <!-- Narrow windows keep the icons and drop the words. -->
        <ContainerQuery Name="Toolbar" Query="max-width:620">
          <Style Selector="TextBlock.label">
            <Setter Property="IsVisible" Value="False" />
          </Style>
        </ContainerQuery>
        <ContainerQuery Name="Toolbar" Query="max-width:420">
          <Style Selector="TextBlock.exposure">
            <Setter Property="IsVisible" Value="False" />
          </Style>
        </ContainerQuery>
      </Border.Styles>
      <WrapPanel Orientation="Horizontal">
        <Button Classes="tool" Command="{Binding FrameAllCommand}" ToolTip.Tip="Frame all">
          <icons:PackIconFontAwesome6 Kind="ExpandSolid" />
        </Button>
        <Button Classes="tool" Command="{Binding FrameSelectionCommand}" ToolTip.Tip="Frame selection (F)">
          <icons:PackIconFontAwesome6 Kind="CrosshairsSolid" />
        </Button>
        <Rectangle Classes="divider" />
        <ToggleButton Classes="tool" IsChecked="{Binding Wireframe}" ToolTip.Tip="Wireframe">
          <icons:PackIconFontAwesome6 Kind="CubeSolid" />
        </ToggleButton>
        <ToggleButton Classes="tool" IsChecked="{Binding ShowBones}" ToolTip.Tip="Show bones (B)">
          <icons:PackIconFontAwesome6 Kind="BoneSolid" />
        </ToggleButton>
        <Rectangle Classes="divider" />
        <Button Classes="tool" Classes.selected="{Binding IsDay}" Command="{Binding SetLightingCommand}" CommandParameter="Day" ToolTip.Tip="Day lighting">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <icons:PackIconFontAwesome6 Kind="SunSolid" />
            <TextBlock Classes="label" Text="Day" />
          </StackPanel>
        </Button>
        <Button Classes="tool" Classes.selected="{Binding IsNight}" Command="{Binding SetLightingCommand}" CommandParameter="Night" ToolTip.Tip="Night lighting">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <icons:PackIconFontAwesome6 Kind="MoonSolid" />
            <TextBlock Classes="label" Text="Night" />
          </StackPanel>
        </Button>
        <Rectangle Classes="divider" />
        <StackPanel Orientation="Horizontal">
          <ToggleButton Classes="tool" IsChecked="{Binding SkyFill}" ToolTip.Tip="Sky fill light">
            <icons:PackIconFontAwesome6 Kind="CloudSunSolid" />
          </ToggleButton>
          <icons:PackIconFontAwesome6 Kind="CircleHalfStrokeSolid" Width="13" Height="13" Margin="8,0,6,0"
            VerticalAlignment="Center" Foreground="{StaticResource SecondaryText}" ToolTip.Tip="Exposure" />
          <Slider Value="{Binding Exposure}" Minimum="-4" Maximum="4" TickFrequency="0.5" IsSnapToTickEnabled="True"
            Width="110" VerticalAlignment="Center" Margin="0,-6" ToolTip.Tip="Exposure in stops" />
          <TextBlock Classes="exposure" Text="{Binding ExposureText}" Width="46" Margin="8,0,0,0" FontSize="12"
            VerticalAlignment="Center" Foreground="{StaticResource SecondaryText}" />
          <Button Classes="tool" Command="{Binding ResetExposureCommand}" ToolTip.Tip="Reset exposure">
            <icons:PackIconFontAwesome6 Kind="RotateLeftSolid" Width="12" Height="12" />
          </Button>
        </StackPanel>
      </WrapPanel>
    </Border>

    <Border DockPanel.Dock="Top" Background="#4A2626" BorderBrush="{StaticResource ErrorText}" BorderThickness="0,0,0,1"
      Padding="10,6,4,6" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="tool" Height="24" MinWidth="24" Padding="0" VerticalAlignment="Top"
          Command="{Binding DismissErrorCommand}" ToolTip.Tip="Dismiss">
          <icons:PackIconFontAwesome6 Kind="XmarkSolid" Width="9" Height="9" />
        </Button>
        <icons:PackIconFontAwesome6 Kind="TriangleExclamationSolid" Width="14" Height="14" Margin="0,3,10,0" VerticalAlignment="Top"
          Foreground="{StaticResource ErrorText}" />
        <SelectableTextBlock Text="{Binding Error}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" MaxHeight="90" />
      </DockPanel>
    </Border>

    <Grid Background="#1c1e23" ClipToBounds="True">
      <controls:BfresViewport x:Name="Viewport" />
      <Border IsVisible="{Binding RenderError, Converter={x:Static ObjectConverters.IsNotNull}}" Background="#E6202226"
        BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="6" Padding="16,12" MaxWidth="460" Margin="16"
        HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="6">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <icons:PackIconFontAwesome6 Kind="TriangleExclamationSolid" Width="14" Height="14" Foreground="{StaticResource ErrorText}" />
            <TextBlock Text="3D view unavailable" FontWeight="SemiBold" />
          </StackPanel>
          <SelectableTextBlock Text="{Binding RenderError}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource SecondaryText}" />
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
