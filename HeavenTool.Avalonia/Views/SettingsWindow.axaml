<fa:FAAppWindow xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:icons="https://github.com/MahApps/IconPacks.Avalonia"
  xmlns:fa="clr-namespace:FluentAvalonia.UI.Windowing;assembly=FluentAvalonia"
  xmlns:vm="using:HeavenTool.Avalonia.ViewModels"
  xmlns:views="using:HeavenTool.Avalonia.Views"
  xmlns:settings="using:HeavenTool.Avalonia.Settings"
  xmlns:app="clr-namespace:HeavenTool.Avalonia;assembly=HeavenTool.Avalonia"
  x:Class="HeavenTool.Avalonia.Views.SettingsWindow"
  x:DataType="vm:SettingsViewModel"
  Title="Settings" Width="980" Height="660" MinWidth="680" MinHeight="420"
  Background="{StaticResource WindowBackground}">

  <fa:FAAppWindow.Resources>
    <DataTemplate x:Key="StatusTemplate" x:DataType="vm:SettingStatus">
      <DockPanel>
        <icons:PackIconFontAwesome6 Kind="{Binding Kind, Converter={x:Static views:SettingsWindow.StatusIcon}}"
          Foreground="{Binding Kind, Converter={x:Static views:SettingsWindow.StatusBrush}}"
          Width="14" Height="14" Margin="0,2,10,0" VerticalAlignment="Top" />
        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource SecondaryText}" />
      </DockPanel>
    </DataTemplate>
  </fa:FAAppWindow.Resources>

  <Grid RowDefinitions="32,*">
    <DockPanel Grid.Row="0" Background="{StaticResource TitleBarBackground}" WindowDecorationProperties.ElementRole="TitleBar">
      <Image Source="/Assets/Icons/leaf.ico" Margin="10 0" Height="16" />
      <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Title, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}" />
      <TextBlock Text="{x:Static app:App.DisplayVersion}" Margin="5 0 0 0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource DimText}" />
    </DockPanel>

    <Grid Grid.Row="1" ColumnDefinitions="210,*">
      <Border Background="{StaticResource MenuBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,1,0">
        <ListBox Classes="nav" SelectionMode="AlwaysSelected" Background="Transparent" Margin="8">
          <ListBoxItem x:Name="ModManagerCategory" IsSelected="True">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <icons:PackIconFontAwesome6 Kind="CubesSolid" />
              <TextBlock Text="Mod Manager" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem x:Name="GameCategory">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <icons:PackIconFontAwesome6 Kind="GamepadSolid" />
              <TextBlock Text="Game Settings" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem x:Name="DebugCategory">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <icons:PackIconFontAwesome6 Kind="BugSolid" />
              <TextBlock Text="Debug" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
        </ListBox>
      </Border>

      <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,20,28,28">
          <Border Classes="banner" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{StaticResource ErrorText}" />
          </Border>

          <!-- Mod Manager -->
          <StackPanel IsVisible="{Binding #ModManagerCategory.IsSelected}">
            <StackPanel Classes="section">
              <icons:PackIconFontAwesome6 Kind="DisplaySolid" />
              <TextBlock Text="Emulator" />
            </StackPanel>
            <Border Classes="card">
              <StackPanel>
                <Border Classes="row">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Classes="title" Text="Deploy to" />
                      <TextBlock Classes="description" Text="Mods deploy as one &quot;Heaven Tool&quot; mod in the emulator's mod folder, so you can turn them all off from the emulator." />
                    </StackPanel>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding EmulatorOptions}" SelectedItem="{Binding SelectedEmulator}" MinWidth="170" VerticalAlignment="Center">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="settings:EmulatorInstall">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Text="not found" IsVisible="{Binding !Found}" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource DimText}" />
                          </StackPanel>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </Grid>
                </Border>
                <Border Classes="row">
                  <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                      <TextBox Text="{Binding ModFolder}" PlaceholderText="Mod folder for title 01006F8002326000" />
                      <Button Grid.Column="1" Command="{Binding BrowseModFolderCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <icons:PackIconFontAwesome6 Kind="FolderOpenSolid" />
                          <TextBlock Text="Browse" />
                        </StackPanel>
                      </Button>
                      <Button Classes="icon" Grid.Column="2" Command="{Binding OpenFolderCommand}" CommandParameter="{Binding ModFolder}" ToolTip.Tip="Open in file manager">
                        <icons:PackIconFontAwesome6 Kind="ArrowUpRightFromSquareSolid" />
                      </Button>
                    </Grid>
                    <ContentControl Content="{Binding ModFolderStatus}" ContentTemplate="{StaticResource StatusTemplate}" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <StackPanel Classes="section">
              <icons:PackIconFontAwesome6 Kind="BoxArchiveSolid" />
              <TextBlock Text="Library" />
            </StackPanel>
            <Border Classes="card">
              <StackPanel>
                <Border Classes="row">
                  <StackPanel Spacing="10">
                    <StackPanel>
                      <TextBlock Classes="title" Text="Mod library" />
                      <TextBlock Classes="description" Text="Installed mods are kept here, unpacked, and merged from here when you deploy." />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                      <TextBox Text="{Binding LibraryFolder}" />
                      <Button Grid.Column="1" Command="{Binding BrowseLibraryFolderCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <icons:PackIconFontAwesome6 Kind="FolderOpenSolid" />
                          <TextBlock Text="Browse" />
                        </StackPanel>
                      </Button>
                      <Button Classes="icon" Grid.Column="2" Command="{Binding OpenFolderCommand}" CommandParameter="{Binding LibraryFolder}" ToolTip.Tip="Open in file manager">
                        <icons:PackIconFontAwesome6 Kind="ArrowUpRightFromSquareSolid" />
                      </Button>
                      <Button Classes="icon" Grid.Column="3" Command="{Binding ResetLibraryFolderCommand}" ToolTip.Tip="Use the default folder">
                        <icons:PackIconFontAwesome6 Kind="RotateLeftSolid" />
                      </Button>
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <StackPanel Classes="section">
              <icons:PackIconFontAwesome6 Kind="GlobeSolid" />
              <TextBlock Text="GameBanana" />
            </StackPanel>
            <Border Classes="card">
              <StackPanel>
                <Border Classes="row">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Classes="title" Text="Show mods with content ratings" />
                      <TextBlock Classes="description" Text="Lists mods their authors marked as having mature content." />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowRatedMods}" OnContent="On" OffContent="Off" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </StackPanel>
            </Border>

            <StackPanel Classes="section">
              <icons:PackIconFontAwesome6 Kind="PlugSolid" />
              <TextBlock Text="Skyline" />
            </StackPanel>
            <Border Classes="card">
              <StackPanel>
                <Border Classes="row">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Classes="title" Text="Install Skyline" />
                      <TextBlock Classes="description" Text="Deploys skyline-acnh from the acnhmodding GitHub with your mods. Skyline loads code plugins into the game." />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding InstallSkyline}" OnContent="On" OffContent="Off" VerticalAlignment="Center" />
                  </Grid>
                </Border>
                <Border Classes="row" x:Name="AutoRstbRow" IsEnabled="{Binding InstallSkyline}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Classes="title" Text="auto-rstb" />
                      <TextBlock Classes="description" Text="Fixes the resource size table as the game runs, so mods can make game files larger. Works for mods installed without Heaven Tool too." />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding InstallAutoRstb}" OnContent="On" OffContent="Off" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </StackPanel>
            </Border>
            <ContentControl IsVisible="{Binding RstbFixOff}" Margin="16,8,16,0"
              Content="{x:Static vm:SettingsViewModel.RstbFixOffWarning}" ContentTemplate="{StaticResource StatusTemplate}" />
          </StackPanel>

          <!-- Game Settings -->
          <StackPanel IsVisible="{Binding #GameCategory.IsSelected}">
            <StackPanel Classes="section">
              <icons:PackIconFontAwesome6 Kind="HardDriveSolid" />
              <TextBlock Text="Game files" />
            </StackPanel>
            <Border Classes="card">
              <StackPanel>
                <Border Classes="row">
                  <StackPanel Spacing="10">
                    <StackPanel>
                      <TextBlock Classes="title" Text="Extracted romfs" />
                      <TextBlock Classes="description" Text="Mod tools open files from here, and the Mod Manager compares mods against it. Heaven Tool never changes these files." />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                      <TextBox Text="{Binding RomfsFolder}" PlaceholderText="Folder with the extracted romfs" />
                      <Button Grid.Column="1" Command="{Binding BrowseRomfsFolderCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <icons:PackIconFontAwesome6 Kind="FolderOpenSolid" />
                          <TextBlock Text="Browse" />
                        </StackPanel>
                      </Button>
                      <Button Classes="icon" Grid.Column="2" Command="{Binding OpenFolderCommand}" CommandParameter="{Binding RomfsFolder}" ToolTip.Tip="Open in file manager">
                        <icons:PackIconFontAwesome6 Kind="ArrowUpRightFromSquareSolid" />
                      </Button>
                    </Grid>
                    <ContentControl Content="{Binding RomfsStatus}" ContentTemplate="{StaticResource StatusTemplate}" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Debug -->
          <StackPanel IsVisible="{Binding #DebugCategory.IsSelected}">
            <StackPanel Classes="section">
              <icons:PackIconFontAwesome6 Kind="FileCodeSolid" />
              <TextBlock Text="NookKit" />
            </StackPanel>
            <Border Classes="card">
              <StackPanel>
                <Border Classes="row">
                  <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                      <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Classes="title" Text="Generate NookKit patches" />
                        <TextBlock Classes="description" Text="Compares each enabled library mod with the game files and writes its table rows, messages and pack files as NookKit JSON: NookKit/Bcsv, NookKit/Message and NookKit/Pack, one file per mod. Files a mod adds to a pack are copied out as loose files." />
                      </StackPanel>
                      <Button Grid.Column="1" Command="{Binding GenerateNookKitCommand}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <icons:PackIconFontAwesome6 Kind="WandMagicSparklesSolid" />
                          <TextBlock Text="Generate" />
                        </StackPanel>
                      </Button>
                      <Button Classes="icon" Grid.Column="2" Command="{Binding OpenFolderCommand}" CommandParameter="{Binding NookKitFolder}" VerticalAlignment="Center"
                        IsEnabled="{Binding NookKitFolder, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="Open the last export in file manager">
                        <icons:PackIconFontAwesome6 Kind="ArrowUpRightFromSquareSolid" />
                      </Button>
                    </Grid>
                    <ContentControl Content="{Binding NookKitStatus}" ContentTemplate="{StaticResource StatusTemplate}"
                      IsVisible="{Binding NookKitStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  </StackPanel>
                </Border>
                <Border Classes="row" IsVisible="{Binding NookKitResults.Count}">
                  <ItemsControl ItemsSource="{Binding NookKitResults}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="10" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:NookKitResult">
                        <StackPanel>
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" FontSize="12" Foreground="{StaticResource SecondaryText}" />
                            <TextBlock Classes="title" Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                          </DockPanel>
                          <ItemsControl ItemsSource="{Binding Notes}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="x:String">
                                <TextBlock Classes="description" Text="{Binding}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</fa:FAAppWindow>
