<fluent:FAAppWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:icons="https://github.com/MahApps/IconPacks.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HeavenTool.Avalonia.ViewModels;assembly=HeavenTool.Avalonia"
        xmlns:views="clr-namespace:HeavenTool.Avalonia.Views"
        xmlns:app="clr-namespace:HeavenTool.Avalonia;assembly=HeavenTool.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="600"
        xmlns:fluent="clr-namespace:FluentAvalonia.UI.Windowing;assembly=FluentAvalonia"
        xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
        MinWidth="600" MinHeight="400"
        x:Class="HeavenTool.Avalonia.Views.MainWindow"
        Background="{StaticResource WindowBackground}"
        x:DataType="vm:MainWindowViewModel"
        Title="Heaven Tool">

  <Design.DataContext>
    <vm:MainWindowViewModel/>
  </Design.DataContext>

  <fluent:FAAppWindow.Styles>
    <Style Selector="Border.modCard">
      <Setter Property="Background" Value="{StaticResource CardBackground}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="Margin" Value="0 0 0 6" />
    </Style>
    <!-- Small square icon buttons on a card. -->
    <Style Selector="Button.icon">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon icons|PackIconFontAwesome6">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
    </Style>
    <Style Selector="Button.deploy">
      <Setter Property="Background" Value="{StaticResource ACNHGreen}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Height" Value="38" />
    </Style>
    <Style Selector="Button.deploy:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource ACNHGreenDark}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.deploy:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource ACNHGreenDark}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.deploy:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource ACNHGreenDark}" />
      <Setter Property="Foreground" Value="#B0FFFFFF" />
    </Style>
    <!-- The load order arrows on library cards. -->
    <Style Selector="Button.order">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.order icons|PackIconFontAwesome6">
      <Setter Property="Width" Value="11" />
      <Setter Property="Height" Value="11" />
    </Style>
    <!-- A library mod that is turned off fades, except for its buttons. -->
    <Style Selector="Border.modCard.off :is(Control).fade">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <!-- The search filters' flyout. -->
    <Style Selector="TextBlock.filterLabel">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
    </Style>
    <Style Selector="TextBlock.filterHint">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource DimText}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.sub">
      <Setter Property="Margin" Value="16 0 0 0" />
    </Style>
    <Style Selector="Border.filterBadge">
      <Setter Property="Background" Value="{StaticResource WarningText}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="MinWidth" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Padding" Value="4 0" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0 -6 -6 0" />
    </Style>
    <Style Selector="Border.filterBadge TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#2b2b2b" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- A card's author, which lists the author's mods when clicked. -->
    <Style Selector="Button.author">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.author:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.author:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.author:pointerover TextBlock">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
  </fluent:FAAppWindow.Styles>

  <Grid RowDefinitions="32, *">
    <DockPanel Grid.Row="0" Background="{StaticResource TitleBarBackground}"
               WindowDecorationProperties.ElementRole="TitleBar">
      <Image Source="/Assets/Icons/leaf.ico" Margin="10 0" Height="16"/>
      <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Margin="0 0 0 0" Text="{Binding Title, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"/>
      <TextBlock Text="{x:Static app:App.DisplayVersion}" Margin="5 0 0 0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource DimText}"/>
    </DockPanel>

    <SplitView IsPaneOpen="True"
               OpenPaneLength="200"
               CompactPaneLength="48"
               Grid.Row="1"
               DisplayMode="CompactInline">

      <SplitView.Pane>
        <Grid VerticalAlignment="Stretch" Margin="10" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
          <!-- In the order of ModPage. -->
          <ListBox Grid.Row="0" VerticalAlignment="Stretch" SelectedIndex="{Binding PageIndex}">
            <ListBoxItem>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <icons:PackIconFontAwesome6 Kind="FireSolid" Width="20" Height="20" />
                <TextBlock Text="Trending" Margin="10 0"/>
              </StackPanel>
            </ListBoxItem>

            <ListBoxItem>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <icons:PackIconFontAwesome6 Kind="ClockSolid" Width="20" Height="20" />
                <TextBlock Text="Recent" Margin="10 0"/>
              </StackPanel>
            </ListBoxItem>

            <ListBoxItem>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <icons:PackIconFontAwesome6 Kind="StarSolid" Width="20" Height="20" />
                <TextBlock Text="Favorites" Margin="10 0"/>
              </StackPanel>
            </ListBoxItem>

            <ListBoxItem>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <icons:PackIconFontAwesome6 Kind="DownloadSolid" Width="20" Height="20" />
                <TextBlock Text="Installed" Margin="10 0"/>
                <Border Classes="filterBadge" Margin="0" VerticalAlignment="Center" IsVisible="{Binding HasUpdates}"
                        ToolTip.Tip="{Binding UpdateCount, StringFormat='Updates available: {0}'}">
                  <TextBlock Text="{Binding UpdateCount}" />
                </Border>
              </StackPanel>
            </ListBoxItem>
          </ListBox>

          <StackPanel Grid.Row="1" Spacing="4" Margin="0 10 0 0">
            <Button Classes="deploy" HorizontalAlignment="Stretch" Command="{Binding DeployCommand}"
                    ToolTip.Tip="Copy the turned on mods into the emulator's mod folder, merging the files they share">
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <icons:PackIconFontAwesome6 Kind="RocketSolid" Width="14" Height="14" VerticalAlignment="Center" />
                <TextBlock Text="Deploy" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <TextBlock Text="{Binding DeployStatus}" FontSize="11" Foreground="{StaticResource DimText}" HorizontalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" />
          </StackPanel>

          <Separator Grid.Row="2" Margin="0,10"/>
          <StackPanel Grid.Row="3" Spacing="5">
            <TextBlock HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold">Modding Tools</TextBlock>
            <Button HorizontalAlignment="Stretch" Command="{Binding OpenBCSV}">BCSV Editor</Button>
            <Button HorizontalAlignment="Stretch" Command="{Binding OpenBFRES}">BFRES Viewer</Button>
          </StackPanel>

          <Separator Grid.Row="4" Margin="0,10"/>
          <Button Grid.Row="5" Content="Settings" HorizontalAlignment="Stretch" Command="{Binding OpenSettings}"/>
        </Grid>
      </SplitView.Pane>


      <SplitView.Content>

        <Grid Background="{StaticResource ContentBackground}" RowDefinitions="Auto,Auto,*">

          <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" Background="{StaticResource ACNHGreen}">
            <TextBox x:Name="SearchBox" Grid.Column="0" Background="{StaticResource ACNHGreenDark}" Margin="10"
                     Text="{Binding SearchText}" PlaceholderText="{Binding SearchPlaceholder}">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <!-- The badge sits outside the button so it can hang over its corner. -->
            <Panel Grid.Column="1" Margin="0 10 10 10" IsVisible="{Binding IsOnlinePage}">
              <Button x:Name="FilterButton" Classes="icon" Height="{Binding Bounds.Height, ElementName=SearchBox}" Background="{StaticResource ACNHGreenDark}"
                      ToolTip.Tip="Filters">
                <icons:PackIconFontAwesome6 Kind="FilterSolid" />
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedRight" Opened="FilterFlyout_Opened" Closed="FilterFlyout_Closed">
                    <StackPanel Width="280" Spacing="12">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Filters" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Clear" Padding="10 3" Command="{Binding ClearFiltersCommand}" IsEnabled="{Binding HasActiveFilters}" />
                      </Grid>

                      <StackPanel Spacing="4">
                        <TextBlock Classes="filterLabel" Text="Category" />
                        <ComboBox HorizontalAlignment="Stretch" MaxDropDownHeight="360"
                                  ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:CategoryOption">
                              <TextBlock Text="{Binding Name}" Classes.sub="{Binding IsSubcategory}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Classes="filterHint" Text="Loading categories..." IsVisible="{Binding IsLoadingCategories}" />
                      </StackPanel>

                      <StackPanel Spacing="4">
                        <TextBlock Classes="filterLabel" Text="Author" />
                        <TextBox Text="{Binding AuthorFilter}" PlaceholderText="Any author">
                          <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding ApplyFiltersCommand}" />
                          </TextBox.KeyBindings>
                        </TextBox>
                        <TextBlock Classes="filterHint" Text="A GameBanana member's name. Press Enter to apply." />
                      </StackPanel>

                      <StackPanel Spacing="4">
                        <TextBlock Classes="filterLabel" Text="Sort by" />
                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Sorts}" SelectedItem="{Binding SelectedSort}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SortOption">
                              <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Classes="filterHint" Text="{Binding SortHint}"
                                   IsVisible="{Binding SortHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>

                      <CheckBox Content="Featured mods only" IsChecked="{Binding FeaturedOnly}" />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <Border Classes="filterBadge" IsVisible="{Binding HasActiveFilters}" IsHitTestVisible="False">
                <TextBlock Text="{Binding ActiveFilterCount}" />
              </Border>
            </Panel>
            <Button Grid.Column="2" Background="{StaticResource ACNHGreenDark}" Content="Search" Margin="0 10 10 10"
                    Command="{Binding SearchCommand}" IsVisible="{Binding IsOnlinePage}"/>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" Margin="0 10 10 10" IsVisible="{Binding IsInstalledPage}">
              <Button Background="{StaticResource ACNHGreenDark}" Command="{Binding UpdateAllCommand}" IsVisible="{Binding HasUpdates}"
                      ToolTip.Tip="Install every update found, keeping each mod's place in the list and whether it's on">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <icons:PackIconFontAwesome6 Kind="CircleArrowUpSolid" Width="12" Height="12" />
                  <TextBlock Text="Update all" />
                </StackPanel>
              </Button>
              <Button Background="{StaticResource ACNHGreenDark}" Command="{Binding CheckForUpdatesCommand}"
                      ToolTip.Tip="Ask GameBanana for newer files of the mods installed from it">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <icons:PackIconFontAwesome6 Kind="RotateSolid" Width="12" Height="12" />
                  <TextBlock Text="Check for updates" />
                </StackPanel>
              </Button>
              <Button Background="{StaticResource ACNHGreenDark}" Command="{Binding InstallFromFileCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <icons:PackIconFontAwesome6 Kind="FileZipperSolid" Width="12" Height="12" />
                  <TextBlock Text="Install from file..." />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>

          <Border Grid.Row="1" Background="{StaticResource PanelBackground}" Padding="10 6" IsVisible="{Binding BusyText, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <ProgressBar IsIndeterminate="True" Width="120" VerticalAlignment="Center" />
              <TextBlock Text="{Binding BusyText}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>

          <ScrollViewer Grid.Row="2" x:Name="ModScroller">
            <StackPanel Margin="10">
              <TextBlock Text="Mods higher in the list win when two change the same file. Turn a mod off to leave it out of the next deploy."
                         FontSize="12" Foreground="{StaticResource DimText}" TextWrapping="Wrap" Margin="2 0 0 8">
                <TextBlock.IsVisible>
                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="IsInstalledPage"/>
                    <Binding Path="Message" Converter="{x:Static StringConverters.IsNullOrEmpty}"/>
                  </MultiBinding>
                </TextBlock.IsVisible>
              </TextBlock>
              <TextBlock Text="{Binding UpdateStatus}" FontSize="12" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="2 0 0 8">
                <TextBlock.IsVisible>
                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="IsInstalledPage"/>
                    <Binding Path="UpdateStatus" Converter="{x:Static StringConverters.IsNotNullOrEmpty}"/>
                  </MultiBinding>
                </TextBlock.IsVisible>
              </TextBlock>
              <ItemsControl ItemsSource="{Binding Mods}">
                <!-- Only the cards in view are built, so a long feed doesn't keep every card and thumbnail alive. -->
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ModCardViewModel">
                    <Border Classes="modCard" Classes.off="{Binding IsTurnedOff}">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                          <StackPanel VerticalAlignment="Center" Margin="0 0 8 0" IsVisible="{Binding IsLibraryCard}">
                            <Button Classes="order" Command="{Binding MoveUpCommand}" ToolTip.Tip="Higher priority">
                              <icons:PackIconFontAwesome6 Kind="ChevronUpSolid" />
                            </Button>
                            <Button Classes="order" Command="{Binding MoveDownCommand}" ToolTip.Tip="Lower priority">
                              <icons:PackIconFontAwesome6 Kind="ChevronDownSolid" />
                            </Button>
                          </StackPanel>

                          <Border Classes="fade" Width="96" Height="64" CornerRadius="4" ClipToBounds="True"
                                  Background="{StaticResource PanelBackground}" VerticalAlignment="Center">
                            <Panel>
                              <icons:PackIconFontAwesome6 Kind="ImageRegular" Width="20" Height="20" Foreground="{StaticResource DimText}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasImage}" />
                              <Image asyncImageLoader:ImageLoader.Source="{Binding ImageUrl}" Stretch="UniformToFill" IsVisible="{Binding HasImage}">
                                <ToolTip.Tip>
                                  <!-- Wider than the theme's tooltips, and sized up front so it isn't blank while the image loads. -->
                                  <ToolTip MaxWidth="560" Padding="4">
                                    <Panel Width="530" Height="298">
                                      <TextBlock Text="Loading preview..." Foreground="{StaticResource DimText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 IsVisible="{Binding #PreviewImage.(asyncImageLoader:ImageLoader.IsLoading)}" />
                                      <Image x:Name="PreviewImage" asyncImageLoader:ImageLoader.Source="{Binding PreviewUrl}" Stretch="Uniform" />
                                    </Panel>
                                  </ToolTip>
                                </ToolTip.Tip>
                              </Image>
                            </Panel>
                          </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Classes="fade" VerticalAlignment="Center" Spacing="2">
                          <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                          <TextBlock Text="{Binding Author, StringFormat='by {0}'}" FontSize="12" Foreground="{StaticResource SecondaryText}"
                                     IsVisible="{Binding HasPlainAuthor}"/>
                          <Button Classes="author" Command="{Binding FilterByAuthorCommand}" IsVisible="{Binding CanFilterByAuthor}"
                                  ToolTip.Tip="{Binding Author, StringFormat='Show mods by {0}'}">
                            <TextBlock Text="{Binding Author, StringFormat='by {0}'}" FontSize="12" Foreground="{StaticResource SecondaryText}"/>
                          </Button>
                          <TextBlock Text="{Binding Details}" FontSize="12" Foreground="{StaticResource DimText}" TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{Binding TagsTip}"
                                     IsVisible="{Binding Details, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                          <TextBlock Text="{Binding UpdateText}" FontSize="12" Foreground="{StaticResource WarningText}" TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{Binding UpdateText}" IsVisible="{Binding HasUpdate}"/>
                          <StackPanel IsVisible="{Binding IsBusy}" Spacing="2" Margin="0 4 0 0">
                            <ProgressBar Value="{Binding Progress}" Maximum="1" IsIndeterminate="{Binding !IsProgressKnown}" />
                            <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                          <ToggleSwitch IsChecked="{Binding IsModEnabled}" IsVisible="{Binding IsLibraryCard}" OnContent="" OffContent="" MinWidth="0"
                                        ToolTip.Tip="{Binding IsModEnabled, Converter={x:Static views:MainWindow.EnabledTip}}" />
                          <Button Classes="icon" Command="{Binding ToggleFavoriteCommand}" IsVisible="{Binding CanFavorite}"
                                  ToolTip.Tip="{Binding IsFavorite, Converter={x:Static views:MainWindow.FavoriteTip}}">
                            <icons:PackIconFontAwesome6 Kind="{Binding IsFavorite, Converter={x:Static views:MainWindow.FavoriteIcon}}"
                                                        Foreground="{Binding IsFavorite, Converter={x:Static views:MainWindow.FavoriteBrush}}" />
                          </Button>
                          <Button Classes="icon" Command="{Binding OpenPageCommand}" IsVisible="{Binding CanOpenPage}" ToolTip.Tip="Open on GameBanana">
                            <icons:PackIconFontAwesome6 Kind="ArrowUpRightFromSquareSolid" />
                          </Button>
                          <Button Classes="icon" Command="{Binding OpenFolderCommand}" IsVisible="{Binding IsLibraryCard}" ToolTip.Tip="Open folder">
                            <icons:PackIconFontAwesome6 Kind="FolderOpenSolid" />
                          </Button>
                          <Button Classes="icon" Command="{Binding RemoveCommand}" IsVisible="{Binding IsLibraryCard}" ToolTip.Tip="Remove">
                            <icons:PackIconFontAwesome6 Kind="TrashCanSolid" />
                          </Button>
                          <Button Classes="icon" Command="{Binding InstallCommand}" IsVisible="{Binding CanInstall}">
                            <icons:PackIconFontAwesome6 Kind="{Binding InstallIcon}" />
                          </Button>
                          <Button Classes="icon" Command="{Binding UpdateModCommand}" IsVisible="{Binding CanUpdate}" ToolTip.Tip="Update">
                            <icons:PackIconFontAwesome6 Kind="CircleArrowUpSolid" Foreground="{StaticResource WarningText}" />
                          </Button>
                          <Button Command="{Binding CancelInstallCommand}" IsVisible="{Binding CanCancel}" Content="Cancel" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="{Binding Message}" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0 20"
                         IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              <ProgressBar IsIndeterminate="True" Width="160" Margin="0 16" IsVisible="{Binding IsLoading}"/>
              <Button HorizontalAlignment="Center" Margin="0 8" Content="Load more" Command="{Binding LoadMoreCommand}">
                <Button.IsVisible>
                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="HasMore"/>
                    <Binding Path="!IsLoading"/>
                  </MultiBinding>
                </Button.IsVisible>
              </Button>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </SplitView.Content>
    </SplitView>

  </Grid>

</fluent:FAAppWindow>
