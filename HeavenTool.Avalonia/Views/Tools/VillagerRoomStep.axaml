<UserControl xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:icons="https://github.com/MahApps/IconPacks.Avalonia"
  xmlns:vc="using:HeavenTool.Avalonia.ViewModels.VillagerCreator"
  xmlns:villagers="using:HeavenTool.ModManager.Villagers"
  x:Class="HeavenTool.Avalonia.Views.Tools.VillagerRoomStep"
  x:DataType="vc:RoomStepViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="VillagerItem" x:DataType="villagers:VillagerInfo">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{Binding Name}" />
        <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource DimText}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="28,20,28,28">
      <TextBlock Classes="page" Text="Room" />
      <TextBlock Classes="intro" Text="The inside of the house and the model's extra settings, each copied from a vanilla villager." />

      <StackPanel Classes="section">
        <icons:PackIconFontAwesome6 Kind="CouchSolid" />
        <TextBlock Text="Copy from" />
      </StackPanel>
      <Border Classes="card">
        <StackPanel>
          <Border Classes="row">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Classes="title" Text="Room" />
                <TextBlock Classes="description" Text="Wallpaper, flooring, music and furniture, from Param/NpcRoom." />
              </StackPanel>
              <ComboBox Grid.Column="1" ItemsSource="{Binding Villagers}" SelectedItem="{Binding RoomFrom}" Width="260"
                VerticalAlignment="Center" ItemTemplate="{StaticResource VillagerItem}" />
            </Grid>
          </Border>
          <Border Classes="row">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Classes="title" Text="Gmo" />
                <TextBlock Classes="description" Text="Settings tied to the model, from Param/Gmo. A villager of the same species fits best." />
                <TextBlock Classes="warning" Margin="0,4,0,0" Text="{Binding GmoWarning}"
                  IsVisible="{Binding GmoWarning, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>
              <ComboBox Grid.Column="1" ItemsSource="{Binding Villagers}" SelectedItem="{Binding GmoFrom}" Width="260"
                VerticalAlignment="Center" ItemTemplate="{StaticResource VillagerItem}" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
