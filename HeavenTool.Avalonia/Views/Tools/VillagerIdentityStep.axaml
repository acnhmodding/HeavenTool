<UserControl xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:icons="https://github.com/MahApps/IconPacks.Avalonia"
  xmlns:vc="using:HeavenTool.Avalonia.ViewModels.VillagerCreator"
  x:Class="HeavenTool.Avalonia.Views.Tools.VillagerIdentityStep"
  x:DataType="vc:IdentityStepViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="28,0,28,28">
      <StackPanel Classes="section">
        <icons:PackIconFontAwesome6 Kind="TagSolid" />
        <TextBlock Text="Internal names" />
      </StackPanel>
      <Border Classes="card">
        <StackPanel>
          <Border Classes="row">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Classes="title" Text="Label" />
                <TextBlock Classes="description" Text="Names every file of the villager. The first three letters are its species." />
                <TextBlock Classes="error" Text="{Binding LabelError}" IsVisible="{Binding LabelError, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>
              <TextBox Grid.Column="1" Text="{Binding Label}" Width="240" MaxLength="5" VerticalAlignment="Center" FontFamily="{StaticResource CodeFont}" />
            </Grid>
          </Border>
          <Border Classes="row">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Classes="title" Text="UniqueID" />
                <TextBlock Classes="description" Text="The number saves use for the villager. No other villager may have it." />
                <TextBlock Classes="error" Text="{Binding UniqueIdError}" IsVisible="{Binding UniqueIdError, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>
              <NumericUpDown Grid.Column="1" Value="{Binding UniqueId}" Minimum="0" Maximum="65535" Increment="1" FormatString="0"
                Width="240" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Border Classes="row">
            <StackPanel>
              <TextBlock Classes="title" Text="Model" />
              <TextBlock Classes="description" Text="The Villager Creator doesn't make the model. Put the villager's model here in your mod:" />
              <SelectableTextBlock Classes="code" Text="{Binding ModelPath}" Margin="0,6,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <StackPanel Classes="section">
        <icons:PackIconFontAwesome6 Kind="CommentSolid" />
        <TextBlock Text="Text" />
      </StackPanel>
      <Border Classes="card">
        <StackPanel>
          <Border Classes="row">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Classes="title" Text="Name" />
              </StackPanel>
              <TextBox Grid.Column="1" Text="{Binding Name}" Width="320" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Border Classes="row">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Classes="title" Text="Catchphrase" />
                <TextBlock Classes="description" Text="What the villager ends sentences with." />
              </StackPanel>
              <TextBox Grid.Column="1" Text="{Binding Catchphrase}" Width="320" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Border Classes="row">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Classes="title" Text="Motto" />
                <TextBlock Classes="description" Text="Shown on the villager's profile." />
              </StackPanel>
              <TextBox Grid.Column="1" Text="{Binding Motto}" Width="320" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <StackPanel Classes="section">
        <icons:PackIconFontAwesome6 Kind="LanguageSolid" />
        <TextBlock Text="Translations" />
      </StackPanel>
      <TextBlock Classes="note" Text="Languages you leave empty use the text above." />
      <Border Classes="card">
        <StackPanel>
          <Grid ColumnDefinitions="150,*,*,*" ColumnSpacing="8" Margin="16,10,16,6">

            <TextBlock Grid.Column="1" Classes="description" Text="Name" />
            <TextBlock Grid.Column="2" Classes="description" Text="Catchphrase" />
            <TextBlock Grid.Column="3" Classes="description" Text="Motto" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Translations}" Margin="16,0,16,12">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vc:TranslationViewModel">
                <Grid ColumnDefinitions="150,*,*,*" ColumnSpacing="8">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" FontSize="13" />
                  </StackPanel>
                  <TextBox Grid.Column="1" Text="{Binding Name}" />
                  <TextBox Grid.Column="2" Text="{Binding Catchphrase}" />
                  <TextBox Grid.Column="3" Text="{Binding Motto}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
