<UserControl xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:icons="https://github.com/MahApps/IconPacks.Avalonia"
  xmlns:vc="using:HeavenTool.Avalonia.ViewModels.VillagerCreator"
  xmlns:villagers="using:HeavenTool.ModManager.Villagers"
  x:Class="HeavenTool.Avalonia.Views.Tools.VillagerDonorStep"
  x:DataType="vc:DonorStepViewModel">
  <DockPanel Margin="28,20,28,20">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <TextBlock Classes="page" Text="Start from a villager" />
      <TextBlock Classes="intro"
        Text="The new villager starts as a copy of a vanilla one: its personality, birthday, favorites, clothing, house and room. Pick the closest to what you have in mind and change the rest in the next steps. To continue a villager you made before, open its project file." />
    </StackPanel>

    <Border DockPanel.Dock="Top" Classes="banner" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{StaticResource ErrorText}" />
    </Border>

    <TextBox DockPanel.Dock="Top" Text="{Binding Search}" PlaceholderText="Search by name or label" Margin="0,0,0,8">
      <TextBox.InnerLeftContent>
        <icons:PackIconFontAwesome6 Kind="MagnifyingGlassSolid" Width="12" Height="12" Margin="10,0,2,0"
          VerticalAlignment="Center" Foreground="{StaticResource DimText}" />
      </TextBox.InnerLeftContent>
    </TextBox>

    <Border Classes="card" ClipToBounds="True">
      <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="villagers:VillagerInfo">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Species}" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource SecondaryText}" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding Label}" FontFamily="Consolas,Menlo,monospace" FontSize="12"
                VerticalAlignment="Center" Foreground="{StaticResource DimText}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </DockPanel>
</UserControl>
